{
  "redirects": [
    {
      "source": "/community.html",
      "destination": "/updates.html",
      "permanent": true
    },
    {
      "source": "/community",
      "destination": "/updates.html",
      "permanent": true
    },
    {
      "source": "/guides.html",
      "destination": "/updates.html",
      "permanent": true
    },
    {
      "source": "/guides",
      "destination": "/updates.html",
      "permanent": true
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=()"
        }
      ]
    }
  ]
}
